;;;; generator.lisp — печать форм Common Lisp в текст файла .lisp
;;;; Перед загрузкой: (load "types.lisp")
;;;;
;;;; Печать встроенная (prin1): скобки всегда верны, отступы ставит SBCL.
;;;; Имена печатаются в нижнем регистре, без приставки пакета —
;;;; для этого в шапку файла пишется (in-package ...) текущего пакета.

(in-package :js-to-lisp)

;;;; ============================================================
;;;; ОДНА ФОРМА
;;;; ============================================================

(defun generate-form (form)
  "Печатает одну форму строкой: нижний регистр, красивая печать."
  (let ((*print-case* :downcase)
        (*print-pretty* t))
    (prin1-to-string form)))

;;;; ============================================================
;;;; ШАПКА ФАЙЛА
;;;; ============================================================

(defun generate-header ()
  "Строка шапки: комментарий и (in-package ...) текущего пакета."
  (format nil ";;;; Сгенерировано транслятором js-to-lisp~%(in-package :~(~a~))~%"
          (package-name *package*)))

;;;; ============================================================
;;;; ВЕСЬ ФАЙЛ
;;;; ============================================================

(defun generate-body (forms)
  "Соединяет напечатанные формы пустой строкой между ними."
  (format nil "~{~a~^~%~%~}" (mapcar #'generate-form forms)))

(defun generate-program (forms)
  "Список форм → полный текст файла: шапка, пустая строка, формы."
  (format nil "~a~%~a~%" (generate-header) (generate-body forms)))

;;;; ============================================================
;;;; ЗАПИСЬ НА ДИСК
;;;; ============================================================

(defun write-text-file (path text)
  "Записывает строку text в файл path, заменяя старое содержимое."
  (with-open-file (stream path
                          :direction :output
                          :if-exists :supersede
                          :if-does-not-exist :create
                          :external-format :utf-8)
    (write-string text stream))
  path)
